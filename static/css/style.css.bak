/* ─── Variables ─────────────────────────────────── */
:root {
  --indigo: #6378ff;
  --violet: #9b59f5;
  --teal:   #00d4aa;
  --green:  #00e676;
  --red:    #ff4d6d;
  --amber:  #ffb300;
  --bg:     #0d0f1a;
  --bg-card:#151929;
  --bg-deep:#0a0c18;
  --border: rgba(255,255,255,0.07);
  --text-dim:#8892b0;
  --text-muted:#555e7a;
  --r-sm:6px; --r-md:10px; --r-lg:14px; --r-xl:20px;
  --font-display:'Inter', system-ui, sans-serif;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--font-display);background:var(--bg);color:#ccd6f6;line-height:1.6;min-height:100vh;}
a{color:var(--indigo);text-decoration:none;}
a:hover{text-decoration:underline;}
input,select,textarea,button{font-family:inherit;}

/* ─── Auth ───────────────────────────────────────── */
.auth-bg{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(ellipse at 20% 50%,rgba(99,120,255,.12) 0%,transparent 60%),
             radial-gradient(ellipse at 80% 20%,rgba(155,89,245,.10) 0%,transparent 50%),
             var(--bg);
  padding:20px;
}
.auth-card{
  background:var(--bg-card);border-radius:var(--r-xl);padding:40px;
  width:100%;max-width:440px;border:1px solid var(--border);
  box-shadow:0 20px 60px rgba(0,0,0,.5);position:relative;z-index:1;
}
.auth-logo{font-size:28px;font-weight:900;letter-spacing:-1px;color:#fff;margin-bottom:6px;}
.auth-logo span{color:var(--indigo);}
.auth-sub{color:var(--text-dim);font-size:13px;margin-bottom:24px;}
.auth-footer{text-align:center;margin-top:20px;font-size:13px;color:var(--text-dim);}

/* ─── Forms ──────────────────────────────────────── */
.form-group{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}
.form-group label{font-size:13px;font-weight:600;color:#a8b2d8;}
.form-group input,.form-group select,.form-group textarea{
  background:var(--bg-deep);border:1px solid var(--border);border-radius:var(--r-md);
  color:#fff;padding:10px 14px;font-size:14px;outline:none;transition:border .2s;
}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--indigo);}
.form-group input[type=file]{padding:8px;}

/* ─── Buttons ────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:var(--r-md);font-size:14px;font-weight:600;cursor:pointer;border:none;transition:opacity .2s,transform .1s;white-space:nowrap;}
.btn:hover:not(:disabled){opacity:.88;transform:translateY(-1px);}
.btn:disabled{opacity:.4;cursor:not-allowed;}
.btn-primary{background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;}
.btn-secondary{background:rgba(255,255,255,.07);color:#ccd6f6;border:1px solid var(--border);}
.btn-success{background:linear-gradient(135deg,#00b894,var(--teal));color:#fff;}
.btn-danger{background:linear-gradient(135deg,var(--red),#c0392b);color:#fff;}
.btn-block{width:100%;justify-content:center;}
.btn-sm{padding:6px 14px;font-size:12px;}
.btn-lg{padding:13px 28px;font-size:16px;}

/* ─── Alerts ─────────────────────────────────────── */
.alert{padding:12px 16px;border-radius:var(--r-md);font-size:13px;margin-bottom:14px;border:1px solid transparent;}
.alert-error{background:rgba(255,77,109,.1);border-color:rgba(255,77,109,.3);color:#ff8099;}
.alert-success{background:rgba(0,230,118,.08);border-color:rgba(0,230,118,.25);color:var(--green);}
.info-box{font-size:12.5px;color:var(--text-dim);padding:10px 14px;background:rgba(99,120,255,.06);border-radius:var(--r-md);border:1px solid var(--border);margin-top:8px;}

/* ─── Badges ─────────────────────────────────────── */
.badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:99px;font-size:11px;font-weight:700;letter-spacing:.3px;}
.badge-normal{background:rgba(99,120,255,.15);color:var(--indigo);}
.badge-live{background:rgba(0,230,118,.12);color:var(--green);}
.badge-upcoming{background:rgba(255,179,0,.12);color:var(--amber);}
.badge-ended{background:rgba(255,77,109,.12);color:var(--red);}
.badge-pass{background:rgba(0,230,118,.12);color:var(--green);}
.badge-fail{background:rgba(255,77,109,.12);color:var(--red);}

/* ─── Dashboard ──────────────────────────────────── */
.dashboard-container{display:flex;min-height:100vh;}

.sidebar{
  width:240px;min-height:100vh;background:var(--bg-card);
  border-right:1px solid var(--border);display:flex;flex-direction:column;
  padding:24px 16px;position:sticky;top:0;height:100vh;overflow-y:auto;flex-shrink:0;
}
.sidebar-logo{font-size:22px;font-weight:900;letter-spacing:-1px;color:#fff;margin-bottom:28px;padding:0 8px;}
.sidebar-logo span{color:var(--indigo);}
.sidebar-nav{display:flex;flex-direction:column;gap:4px;flex:1;}
.nav-item{padding:10px 12px;border-radius:var(--r-md);color:var(--text-dim);font-size:14px;font-weight:500;transition:all .2s;cursor:pointer;text-decoration:none;display:block;}
.nav-item:hover,.nav-item.active{background:rgba(99,120,255,.12);color:#fff;text-decoration:none;}
.nav-item.active{color:var(--indigo);font-weight:700;}
.sidebar-footer{border-top:1px solid var(--border);padding-top:16px;display:flex;flex-direction:column;gap:10px;}
.user-info{font-size:13px;color:var(--text-dim);padding:0 4px;}

.main-content{flex:1;padding:32px;overflow-y:auto;max-width:900px;}
.tab-content{display:none;}
.tab-content.active{display:block;}
.section-head{margin-bottom:20px;}
.section-head h2{font-size:22px;font-weight:800;color:#fff;margin-bottom:4px;}
.section-head p{font-size:13px;color:var(--text-dim);}

/* ─── Stats ──────────────────────────────────────── */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin-bottom:24px;}
.stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:20px;text-align:center;}
.stat-icon{font-size:24px;margin-bottom:8px;}
.stat-num{font-size:28px;font-weight:900;color:#fff;line-height:1;}
.stat-label{font-size:12px;color:var(--text-dim);margin-top:4px;}

/* ─── Card ───────────────────────────────────────── */
.card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:20px 24px;margin-bottom:16px;}

/* ─── Exam / Material items ──────────────────────── */
.exam-item{
  background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:16px 20px;margin-bottom:12px;display:flex;align-items:center;gap:16px;
}
.exam-item-title{font-size:15px;font-weight:700;color:#fff;margin-bottom:4px;}
.exam-item-meta{font-size:12px;color:var(--text-dim);}

/* ─── Question block ─────────────────────────────── */
.question-block{
  background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:20px;margin-bottom:14px;display:grid;grid-template-columns:1fr 1fr;gap:12px;
}
.q-full{grid-column:1/-1;}
.delete-btn{grid-column:1/-1;background:rgba(255,77,109,.1);color:var(--red);border:1px solid rgba(255,77,109,.2);border-radius:var(--r-sm);padding:6px 14px;cursor:pointer;font-size:12px;font-weight:600;align-self:end;justify-self:end;}

/* ─── Category filter ────────────────────────────── */
.cat-filter{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.cat-btn{background:var(--bg-card);border:1px solid var(--border);color:var(--text-dim);border-radius:99px;padding:6px 16px;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;}
.cat-btn:hover,.cat-btn.active{background:var(--indigo);border-color:var(--indigo);color:#fff;}
.cat-header{font-size:13px;font-weight:700;color:var(--indigo);padding:10px 0 6px;display:flex;align-items:center;gap:8px;}

/* ─── Countdown ──────────────────────────────────── */
.countdown-box{margin-top:8px;background:rgba(255,179,0,.06);border:1px solid rgba(255,179,0,.2);border-radius:var(--r-md);padding:8px 12px;display:inline-block;}
.countdown-label{font-size:10px;color:var(--amber);font-weight:700;text-transform:uppercase;letter-spacing:1px;}
.countdown-time{font-size:16px;font-weight:800;color:#fff;margin-top:2px;}

/* ─── Progress bar ───────────────────────────────── */
.progress-bar{height:6px;background:rgba(255,255,255,.06);border-radius:99px;overflow:hidden;}
.progress-fill{height:100%;border-radius:99px;transition:width .8s ease;}

/* ─── Exam page ──────────────────────────────────── */
.exam-wrapper{max-width:760px;margin:0 auto;padding:24px 20px;}
.exam-topbar{display:flex;align-items:center;justify-content:space-between;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px 20px;margin-bottom:20px;position:sticky;top:16px;z-index:100;backdrop-filter:blur(10px);}
.exam-topbar h2{font-size:16px;font-weight:800;color:#fff;}
.timer-pill{background:rgba(99,120,255,.15);border:1px solid rgba(99,120,255,.3);color:var(--indigo);padding:8px 18px;border-radius:99px;font-size:16px;font-weight:800;font-variant-numeric:tabular-nums;}
.timer-pill.danger{background:rgba(255,77,109,.15);border-color:rgba(255,77,109,.4);color:var(--red);animation:blink 1s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.5;}}

.question-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--r-lg);padding:22px;margin-bottom:16px;}
.q-num{font-size:11px;font-weight:700;color:var(--indigo);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;}
.q-text{font-size:16px;font-weight:600;color:#fff;margin-bottom:18px;line-height:1.5;}
.option-label{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--r-md);border:1px solid var(--border);margin-bottom:8px;cursor:pointer;transition:all .2s;font-size:14px;color:#ccd6f6;}
.option-label:hover{background:rgba(99,120,255,.08);border-color:rgba(99,120,255,.3);}
.option-label input[type=radio]{accent-color:var(--indigo);width:16px;height:16px;flex-shrink:0;}
.option-label:has(input:checked){background:rgba(99,120,255,.12);border-color:var(--indigo);color:#fff;}

/* ─── Result / Marks Card ────────────────────────── */
.result-wrapper{min-height:100vh;display:flex;align-items:flex-start;justify-content:center;padding:40px 20px;background:var(--bg);}

/* ─── Empty state ────────────────────────────────── */
.empty-state{text-align:center;padding:48px 20px;color:var(--text-dim);}
.es-icon{font-size:40px;display:block;margin-bottom:12px;}

/* ─── Responsive ─────────────────────────────────── */
@media(max-width:768px){
  .dashboard-container{flex-direction:column;}
  .sidebar{width:100%;min-height:auto;height:auto;position:relative;padding:16px;}
  .sidebar-nav{flex-direction:row;flex-wrap:wrap;}
  .main-content{padding:16px;}
  .mc-grid{grid-template-columns:1fr;}
  .mc-score-row{grid-template-columns:1fr 1fr;}
  .stat-grid{grid-template-columns:1fr 1fr;}
  .question-block{grid-template-columns:1fr;}
}
